# Anthropic API key used by harness/filter/run.py and harness/synth/run.py
ANTHROPIC_API_KEY=

# Read-only Postgres DSN for the express-code session store. Falls back to
# ~/.config/nexla-triage/secrets.env if unset.
TRIAGE_DATABASE_URL=

# Where the express-code checkout lives. Defaults to a sibling of this repo,
# then to ./express-code.
EXPRESS_CODE_PATH=
